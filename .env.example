# Copy to .env for local runs. In GitHub Actions set these as repository secrets.
# Every value is optional: a feature whose secret is missing is simply skipped.

# Telegram bot (create with @BotFather) and the chat IDs allowed to use it (comma-separated)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional AI relevance layer on OpenRouter's free models: https://openrouter.ai/keys
# Several keys may be comma-separated; a refused or rate-limited key moves to the next one.
OPENROUTER_API_KEYS=

# Optional X.com collection through an Apify actor
APIFY_TOKEN=

# Optional email delivery of reports (Gmail: use an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=
REPORT_EMAIL_TO_EXEC=

# Optional: use a different config profile directory (default: ./config)
TRACKER_CONFIG_DIR=
